{
  "expo": {
    "name": "Daver",
    "slug": "daver",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
