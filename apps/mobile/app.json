{
  "expo": {
    "name": "Daver",
    "slug": "daver",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "android": {
      "package": "com.dev2820.daver"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa1b299f-3f4c-4d4d-a100-e9197cffc754"
      }
    },
    "owner": "dev2820"
  }
}
